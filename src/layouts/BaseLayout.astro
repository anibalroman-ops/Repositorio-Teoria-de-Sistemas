---
import '../styles/global.css';
import '../styles/v1.css';
import { siteConfig } from '../data/site';
const {
  title = `${siteConfig.courseName} · ${siteConfig.semesterShort}`,
  description = `Repositorio académico del curso ${siteConfig.courseName} — ${siteConfig.career}, USACH.`,
  active = ''
} = Astro.props;
const base = import.meta.env.BASE_URL;
const navItems = [
  ['inicio', 'Inicio', base, '01'],
  ['curso', 'Curso', `${base}curso/`, '02'],
  ['clases', 'Clases', `${base}clases/`, '03'],
  ['evaluaciones', 'Evaluaciones', `${base}evaluaciones/`, '04'],
  ['penaflor', 'Proyecto Peñaflor', `${base}proyecto-penaflor/`, '05'],
  ['recursos', 'Recursos', `${base}recursos/`, '06'],
];
const currentLabel = navItems.find(([id]) => id === active)?.[1] || 'Inicio';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#143f43" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
  </head>
  <body data-semester-start={siteConfig.semesterStart} data-semester-end={siteConfig.semesterEnd}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="app-shell">
      <aside class="app-sidebar" aria-label="Navegación del curso">
        <a class="sidebar-brand" href={base} aria-label="Ir al inicio">
          <span class="brand-mark">TS</span>
          <span>
            <small>{siteConfig.career}</small>
            <strong>{siteConfig.courseName}</strong>
          </span>
        </a>

        <div class="sidebar-meta">
          <span class="meta-label">SEMESTRE</span>
          <strong>{siteConfig.semester}</strong>
          <small>{siteConfig.institution}</small>
        </div>

        <nav class="side-nav">
          {navItems.map(([id,label,href,num]) => (
            <a class:list={['side-link', active === id && 'active']} href={href} aria-current={active === id ? 'page' : undefined}>
              <span class="side-num">{num}</span>
              <span>{label}</span>
            </a>
          ))}
        </nav>

        <div class="sidebar-footer">
          <div class="semester-progress">
            <div class="progress-copy"><span>Avance del semestre</span><strong id="semester-progress-label">0%</strong></div>
            <div class="progress-track" aria-hidden="true"><span id="semester-progress-bar"></span></div>
          </div>
          <span class="sidebar-note">{siteConfig.repositoryLabel} · v{siteConfig.version}</span>
        </div>
      </aside>

      <div class="workspace">
        <header class="utilitybar">
          <div>
            <span class="utility-eyebrow">Repositorio del curso</span>
            <strong>{currentLabel}</strong>
          </div>
          <div class="utility-actions">
            <a class="search-link" href={`${base}buscar/`} aria-label="Buscar en el repositorio">⌕ <span>Buscar</span></a>
            <span class="status-pill"><i></i> {siteConfig.semesterShort}</span>
            {siteConfig.moodleUrl ? (
              <a class="moodle-link" href={siteConfig.moodleUrl} target="_blank" rel="noreferrer">Campus Virtual ↗</a>
            ) : (
              <span class="moodle-link disabled" title="El enlace se incorporará cuando se configure Campus Virtual">Campus Virtual ↗</span>
            )}
          </div>
        </header>

        <div id="contenido"><slot /></div>

        <footer class="footer">
          <span>{siteConfig.courseName} · {siteConfig.career}</span>
          <span>{siteConfig.institution}</span>
        </footer>
      </div>
    </div>

    <script is:inline>
      (() => {
        const body = document.body;
        const start = new Date(`${body.dataset.semesterStart}T00:00:00`);
        const end = new Date(`${body.dataset.semesterEnd}T23:59:59`);
        const now = new Date();
        const total = Math.max(1, end - start);
        const pct = Math.max(0, Math.min(100, Math.round(((now - start) / total) * 100)));
        const bar = document.getElementById('semester-progress-bar');
        const label = document.getElementById('semester-progress-label');
        if (bar) bar.style.width = `${pct}%`;
        if (label) label.textContent = `${pct}%`;
      })();
    </script>
  </body>
</html>
