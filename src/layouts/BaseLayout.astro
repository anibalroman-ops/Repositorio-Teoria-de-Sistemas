---
import '../styles/global.css';
const {
  title = 'Teoría de Sistemas · 2026-2',
  description = 'Repositorio académico del curso Teoría de Sistemas — Ingeniería Civil en Ambiente, USACH.',
  active = ''
} = Astro.props;
const base = import.meta.env.BASE_URL;
const navItems = [
  ['inicio', 'Inicio', base, '01'],
  ['curso', 'Curso', `${base}curso/`, '02'],
  ['clases', 'Clases', `${base}clases/`, '03'],
  ['evaluaciones', 'Evaluaciones', `${base}evaluaciones/`, '04'],
  ['penaflor', 'Proyecto Peñaflor', `${base}proyecto-penaflor/`, '05'],
  ['recursos', 'Recursos', `${base}recursos/`, '06'],
];
const currentLabel = navItems.find(([id]) => id === active)?.[1] || 'Inicio';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#143f43" />
    <title>{title}</title>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar" aria-label="Navegación del curso">
        <a class="sidebar-brand" href={base} aria-label="Ir al inicio">
          <span class="brand-mark">TS</span>
          <span>
            <small>Ingeniería Civil en Ambiente</small>
            <strong>Teoría de Sistemas</strong>
          </span>
        </a>

        <div class="sidebar-meta">
          <span class="meta-label">SEMESTRE</span>
          <strong>2026 · 2</strong>
          <small>Universidad de Santiago de Chile</small>
        </div>

        <nav class="side-nav">
          {navItems.map(([id,label,href,num]) => (
            <a class:list={['side-link', active === id && 'active']} href={href}>
              <span class="side-num">{num}</span>
              <span>{label}</span>
            </a>
          ))}
        </nav>

        <div class="sidebar-footer">
          <div class="semester-progress">
            <div class="progress-copy"><span>Ruta del semestre</span><strong>01 / 07</strong></div>
            <div class="progress-track"><span></span></div>
          </div>
          <span class="sidebar-note">Repositorio académico · v0.3</span>
        </div>
      </aside>

      <div class="workspace">
        <header class="utilitybar">
          <div>
            <span class="utility-eyebrow">Repositorio del curso</span>
            <strong>{currentLabel}</strong>
          </div>
          <div class="utility-actions">
            <span class="status-pill"><i></i> 2026-2</span>
            <span class="moodle-link" title="El enlace al Campus Virtual se configurará en la siguiente etapa">Campus Virtual ↗</span>
          </div>
        </header>

        <slot />

        <footer class="footer">
          <span>Teoría de Sistemas · Ingeniería Civil en Ambiente</span>
          <span>Universidad de Santiago de Chile</span>
        </footer>
      </div>
    </div>
  </body>
</html>
