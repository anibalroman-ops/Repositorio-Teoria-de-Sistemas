    ['FICHAS','Fichas de proyectos EHL Peñaflor','PDF · acceso USACH','https://drive.google.com/file/d/1LNa4WkitrvM5EyM1nZLtd6x7D2N8zfdL/view?usp=drivesdk'],
    ['PACCC','Plan de Acción Comunal de Cambio Climático de Peñaflor','PDF · acceso USACH','https://drive.google.com/file/d/1eEw_yyFiawdc8mgM0VJuMH_Ij3WoD2hv/view?usp=drivesdk'],
