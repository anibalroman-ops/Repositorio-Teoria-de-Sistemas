---
import BaseLayout from '../layouts/BaseLayout.astro';
const resources = [
  ['PROG','Programa oficial','Programa institucional de la asignatura','Documento oficial',null],
  ['PDF','Checkland — Pensamiento de sistemas, práctica de sistemas','Lectura base para pensamiento sistémico y SSM','Campus Virtual',null],
  ['LIBRO','Clayton & Radcliffe — Sustainability: A Systems Approach','Lectura para sustentabilidad desde un enfoque sistémico','Campus Virtual',null],
  ['DIAG','Diagnóstico inicial','Línea base individual: fenómeno, observador, sistema e incertidumbre','Google Drive','https://drive.google.com/file/d/1tG5LsTXpCXaOZ-mW0VCaVK5L53XiayGT/view?usp=drivesdk'],
  ['GUÍA','Rich Picture · Estero Los Aromos','Actividad grupal de exploración sistémica del 29 de septiembre','Google Drive','https://drive.google.com/file/d/1lax6RqMukfXO-irAZij1H73NaI6h-qdj/view?usp=drivesdk'],
  ['DIAG','Problemas complejos','Diagnóstico individual previo al trabajo formal con Checkland','Google Drive','https://drive.google.com/file/d/1-PlCDieYE77lKWAKiqjCI1b8erMdppn3/view?usp=drivesdk'],
  ['GUÍA','Del Rich Picture a Sistemas Relevantes','Actividad grupal sobre emergencia, niveles, información, control y definición raíz','Google Drive','https://drive.google.com/file/d/1PerGlamGYHzMkSnYwfuJhj81zxdti17a/view?usp=drivesdk'],
  ['DIAG','Propiedades sistémicas','Diagnóstico individual de emergencia, niveles, información y sistemas relevantes','Google Drive','https://drive.google.com/file/d/1-QYFOoyg08m8N2p2-qlpeAU19pA_dOvE/view?usp=drivesdk'],
  ['GUÍA','Caja negra y transformación','Herramienta para modelar transformación, entradas y salidas','Planificada',null],
  ['MATRIZ','Crosswalk EHL–PACCC','Matriz para analizar relaciones entre instrumentos','Proyecto Peñaflor',null],
  ['MATRIZ','Matriz maestra de implementabilidad','Evidencia, roles, capacidades, dependencias, riesgos e indicadores','Proyecto Peñaflor',null],
];
---
<BaseLayout active="recursos" title="Recursos · Teoría de Sistemas">
  <main class="shell">
    <section class="hero compact">
      <div class="eyebrow">Recursos</div>
      <h1>Biblioteca del curso</h1>
      <p class="lead">Un punto único para localizar materiales docentes, herramientas, lecturas y documentos del proyecto vinculado.</p>
    </section>

    <section class="section">
      <div class="callout"><strong>Regla del repositorio</strong>Los materiales de elaboración docente pueden alojarse o enlazarse directamente desde aquí. Los libros, capítulos y artículos protegidos se mantendrán en Campus Virtual.</div>
    </section>

    <section class="section">
      <div class="section-title"><h2>Recursos disponibles y planificados</h2><span class="card-kicker">Versión 2026-2</span></div>
      <div class="resource-list">
        {resources.map(([type,title,desc,status,href]) => (
          href ? (
            <a class="resource-item" href={href} target="_blank" rel="noreferrer">
              <div class="resource-icon">{type}</div>
              <div><strong>{title}</strong><small>{desc}</small></div>
              <span class="status">{status} ↗</span>
            </a>
          ) : (
            <article class="resource-item">
              <div class="resource-icon">{type}</div>
              <div><strong>{title}</strong><small>{desc}</small></div>
              <span class="status">{status}</span>
            </article>
          )
        ))}
      </div>
    </section>

    <section class="section grid-3">
      <article class="card phase"><h3>Lecturas</h3><p>Textos base y complementarios organizados según la progresión conceptual del curso.</p></article>
      <article class="card phase"><h3>Herramientas</h3><p>Guías operativas para problematizar, distinguir, modelar, diagnosticar e intervenir.</p></article>
      <article class="card phase"><h3>Proyecto Peñaflor</h3><p>Instrumentos públicos, matrices de análisis y productos de trabajo vinculados a EHL y PACCC.</p></article>
    </section>
  </main>
</BaseLayout>
