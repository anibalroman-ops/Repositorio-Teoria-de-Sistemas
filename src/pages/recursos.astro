---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resourceCategories } from '../data/course';
import { resources } from '../data/resources';
import moodleData from '../data/moodle-resources.json';

const moodleResources = (moodleData.items || []).map((item) => ({ ...item, category: 'lecturas' }));
const allResources = [...resources, ...moodleResources];
const initialReadings = resources.filter((item) => item.collection === 'Lecturas iniciales');
const e1Readings = resources.filter((item) => item.collection === 'Evaluación 1');
---
<BaseLayout active="recursos" title="Recursos · Teoría de Sistemas">
  <main class="shell">
    <section class="hero compact">
      <div class="eyebrow">Recursos</div>
      <h1>Biblioteca del curso</h1>
      <p class="lead">Materiales, lecturas e instrumentos organizados por función curricular. Los archivos protegidos permanecen en almacenamiento institucional y no se copian al repositorio público.</p>
    </section>

    <section class="section">
      <div class="callout"><strong>Acceso institucional</strong>Las lecturas obligatorias y los documentos de evaluación se abren o descargan desde Google Drive institucional. Si el archivo está protegido, inicia sesión con tu cuenta USACH. El repositorio público contiene solo las fichas y enlaces de acceso.</div>
    </section>

    <section class="section">
      <div class="section-title"><h2>Lecturas iniciales del curso</h2><span class="card-kicker">L1–L3</span></div>
      <div class="reading-grid">
        {initialReadings.map((item) => (
          <a class="card reading-card" href={item.href} target="_blank" rel="noreferrer">
            <div class="card-kicker">{item.type} · CAMPUS VIRTUAL</div>
            <h3>{item.title.replace(/^Lectura \d · /,'')}</h3>
            <p>{item.description}</p>
            <span class="reading-link">Abrir en Campus Virtual ↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-title"><h2>Lecturas para Evaluación 1</h2><span class="card-kicker">3 TEORÍAS · 6 LECTURAS</span></div>
      <div class="reading-grid">
        {e1Readings.map((item) => (
          <article class="card reading-card">
            <div class="card-kicker">{item.type} · E1 · ACCESO USACH</div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <div class="reading-card-actions">
              {item.viewHref && <a href={item.viewHref} target="_blank" rel="noreferrer">Ver ↗</a>}
              {item.href && <a class="download-link" href={item.href} target="_blank" rel="noreferrer">{item.actionLabel || 'Descargar'} ↓</a>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="grid-3 section resource-category-grid">
      {resourceCategories.map((item) => (
        <button class="card category-card" type="button" data-category={item.id}>
          <span class="resource-icon">{item.icon}</span>
          <span><strong>{item.label}</strong><small>{item.desc}</small></span>
        </button>
      ))}
    </section>

    <section class="card calendar-controls section" aria-label="Buscar y filtrar recursos">
      <div class="calendar-search-wrap">
        <label for="resource-search">Buscar recursos</label>
        <input id="resource-search" class="repo-search-input" type="search" placeholder="Ej.: Checkland, EHL, rúbrica, Rich Picture, lectura…" autocomplete="off" />
      </div>
      <div class="filter-pills" role="group" aria-label="Categorías de recursos">
        <button class="filter-pill active" type="button" data-filter="all">Todo</button>
        {resourceCategories.map((item) => <button class="filter-pill" type="button" data-filter={item.id}>{item.label}</button>)}
      </div>
    </section>

    <section class="section">
      <div class="section-title"><h2>Registro de recursos</h2><span class="card-kicker">BIBLIOTECA CENTRAL</span></div>
      <div class="resource-list" id="resource-list">
        {allResources.map((item) => (
          item.href ? (
            <a class="resource-item library-item" data-category={item.category} data-search={`${item.title} ${item.description} ${item.category}`.toLowerCase()} href={item.href} target="_blank" rel="noreferrer">
              <div class="resource-icon">{item.type}</div>
              <div><strong>{item.title}</strong>{item.collection && <small class="resource-collection">{item.collection}</small>}<small>{item.description}</small></div>
              <span class:list={['status', (item.status === 'Disponible' || item.status === 'Acceso USACH') && 'available-text']}>{item.actionLabel || item.status} ↗</span>
            </a>
          ) : (
            <article class="resource-item library-item" data-category={item.category} data-search={`${item.title} ${item.description} ${item.category}`.toLowerCase()}>
              <div class="resource-icon">{item.type}</div>
              <div><strong>{item.title}</strong>{item.collection && <small class="resource-collection">{item.collection}</small>}<small>{item.description}</small></div>
              <span class="status">{item.status}</span>
            </article>
          )
        ))}
      </div>
      <div id="resource-empty" class="empty-state" hidden><strong>No encontramos recursos.</strong><span>Prueba con otro término o cambia la categoría.</span></div>
    </section>

    <section class="section grid-2">
      <article class="card prose-card"><h2>Lecturas protegidas</h2><p>Los PDFs académicos con restricciones de acceso no se publican dentro de GitHub. Se mantienen en Google Drive con permiso de lectura para la comunidad USACH y desde aquí se ofrecen enlaces individuales para verlos o descargarlos.</p></article>
      <article class="card prose-card"><h2>Campus Virtual</h2><p>Campus Virtual sigue siendo el espacio institucional para comunicaciones, entregas y calificaciones. La biblioteca web funciona como puerta de acceso organizada a los materiales del curso.</p></article>
    </section>

    <style>
      .reading-grid{
        display:grid;
        grid-template-columns:repeat(3,minmax(0,1fr));
        gap:14px;
        align-items:stretch;
      }
      .reading-card{
        display:flex;
        flex-direction:column;
        align-items:flex-start;
        height:100%;
        min-height:250px;
        padding:20px;
      }
      .reading-card .card-kicker{
        line-height:1.25;
        margin-bottom:2px;
      }
      .reading-card h3{
        margin:.45rem 0 .55rem;
        line-height:1.2;
        min-width:0;
      }
      .reading-card p{
        margin:0;
        color:var(--muted);
        font-size:.82rem;
        line-height:1.45;
      }
      .reading-card-actions{
        display:flex;
        align-items:center;
        gap:12px;
        flex-wrap:wrap;
        margin-top:auto;
        padding-top:20px;
      }
      .reading-card-actions a{
        font-size:.75rem;
        font-weight:800;
        color:var(--teal);
        white-space:nowrap;
      }
      .reading-card-actions a:hover{text-decoration:underline}
      .reading-card-actions .download-link{
        display:inline-flex;
        align-items:center;
        padding:7px 10px;
        border:1px solid #b9d4d1;
        border-radius:9px;
        background:#fff;
        text-decoration:none;
      }
      .resource-collection{display:block!important;margin:.18rem 0;color:var(--teal)!important;font-weight:750}
      @media (max-width:900px){
        .reading-grid{grid-template-columns:1fr}
        .reading-card{min-height:auto}
      }
    </style>

    <script is:inline>
      (() => {
        const input = document.getElementById('resource-search');
        const pills = [...document.querySelectorAll('.filter-pill')];
        const categoryCards = [...document.querySelectorAll('.category-card')];
        const items = [...document.querySelectorAll('.library-item')];
        const empty = document.getElementById('resource-empty');
        let active = 'all';
        const normalize = (s) => (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');
        const apply = () => {
          const q = normalize(input?.value);
          let visible = 0;
          items.forEach((item) => {
            const matchesCategory = active === 'all' || item.dataset.category === active;
            const matchesQuery = !q || normalize(item.dataset.search).includes(q);
            const show = matchesCategory && matchesQuery;
            item.hidden = !show;
            if (show) visible++;
          });
          if (empty) empty.hidden = visible !== 0;
        };
        const choose = (value) => {
          active = value;
          pills.forEach((p) => p.classList.toggle('active', p.dataset.filter === active));
          apply();
          document.getElementById('resource-list')?.scrollIntoView({behavior:'smooth', block:'start'});
        };
        input?.addEventListener('input', apply);
        pills.forEach((pill) => pill.addEventListener('click', () => choose(pill.dataset.filter || 'all')));
        categoryCards.forEach((card) => card.addEventListener('click', () => choose(card.dataset.category || 'all')));
      })();
    </script>
  </main>
</BaseLayout>
